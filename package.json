            },
            {
              "id": "ollama-llama32-vision",
              "name": "Llama 3.2 Vision (Ollama local)",
              "provider": "ollama",
              "baseUrl": "http://localhost:11434",
              "modelId": "llama3.2-vision"
            },
            {
              "id": "ollama-codestral",
              "name": "Codestral (Ollama local)",
              "provider": "ollama",
              "baseUrl": "http://localhost:11434",
              "modelId": "codestral"
            }
          ],
          "description": "Configured AI models. API keys are stored in VS Code's secure secret storage.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "provider",
              "baseUrl",
              "modelId"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "provider": {
                "type": "string",
                "enum": [
                  "ollama",
                  "openai",
                  "gemini",
                  "openrouter",
                  "custom"
                ]
              },
              "baseUrl": {
                "type": "string",
                "description": "REST API base URL"
              },
              "modelId": {
                "type": "string",
                "description": "Model identifier used in API requests"
              },
              "description": {
                "type": "string",
                "description": "Short subtitle shown in the model picker"
              },
              "audio": {
                "type": "boolean",
                "description": "The model accepts voice messages (audio) directly"
              },
              "family": {
                "type": "string",
                "description": "Models with the same family and provider share one row in the model picker, with a slider for the variant"
              },
              "variant": {
                "type": "string",
                "description": "Variant label shown beside the slider, e.g. 'Super 120B'"
              }
            }
          }
        },
        "ragAssistant.activeModelId": {
          "type": "string",
          "default": "ollama-cloud-gemma4",
          "description": "ID of the currently active model"
        },
        "ragAssistant.visionModelId": {
          "type": "string",
          "default": "ollama-cloud-gemma4",
          "description": "Model that analyzes attached images. Its description is passed to the active model, which still writes the reply."
        },
        "ragAssistant.systemPrompt": {
          "type": "string",
          "default": "You are a helpful AI coding assistant with deep knowledge of software engineering.\n\nWhen your response includes file contents, ALWAYS use this exact format for EVERY file:\n\n### FILE: relative/path/to/file.ext\n```language\nfile content here\n```\n\nRules:\n- Use relative paths from project root (e.g. css/style.css, not /css/style.css)\n- Every file must have its own ### FILE: header\n- Put ALL files in the response, complete and ready to use\n- After the files, you may add brief explanations\n\nThis format allows the editor to auto-create the files.",
          "editPresentation": "multilineText",
          "description": "System prompt prepended to every conversation"
        },
        "ragAssistant.maxTokens": {
          "type": "number",
          "default": 8192,
          "description": "Maximum output tokens per response"
        },
        "ragAssistant.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 2,
          "description": "Model temperature (0 = deterministic, 2 = very creative)"
        },
        "ragAssistant.contextWindow": {
          "type": "number",
          "default": 24000,
          "description": "Estimated token budget for context window. History is auto-truncated to fit."
        },
        "ragAssistant.policyGuardianEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable PolicyGuardian security checks on shell commands"
        },
        "ragAssistant.ragTopK": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Number of RAG chunks to retrieve per query"
        },
        "ragAssistant.agentRole": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "architect",
            "developer",
            "reviewer",
            "tester",
            "docwriter",
            "security",
            "refactor",
            "optimizer",
            "debugger",
            "designer",
            "manager"
          ],
          "description": "Default agent role for new conversations"
        },
        "ragAssistant.brightDataZone": {
          "type": "string",
          "default": "",
          "description": "Bright Data SERP API zone name, used with the Bright Data API key for real Google results in Research mode. Empty = DuckDuckGo fallback."
        },
        "ragAssistant.audioModelId": {
          "type": "string",
          "default": "openrouter-gemma4-26b",
          "description": "Model that listens to voice messages when the selected model cannot hear audio"
        },
        "ragAssistant.openRouterAppUrl": {
          "type": "string",
          "default": "",
          "description": "URL that identifies this app to OpenRouter (HTTP-Referer). Some free models only serve apps OpenRouter recognises as agentic. Default: http://localhost"
        },
        "ragAssistant.openRouterCategories": {
          "type": "string",
          "default": "",
          "description": "OpenRouter app categories sent with every request (max 2, comma separated, e.g. ide-extension,cli-agent). OpenRouter's agent-only free models check them. Default: ide-extension,cli-agent"
        }
      }
    },
    "keybindings": [
      {
        "command": "ragAssistant.review.nextHunk",
        "key": "alt+j",
        "when": "editorTextFocus && ragAssistant.hasReview"
      },
      {
        "command": "ragAssistant.review.prevHunk",
        "key": "alt+k",
        "when": "editorTextFocus && ragAssistant.hasReview"
      },
      {
        "command": "ragAssistant.review.acceptHere",
        "key": "alt+enter",
        "when": "editorTextFocus && ragAssistant.hasReview"
      },
      {
        "command": "ragAssistant.review.revertHere",
        "key": "alt+shift+backspace",
        "when": "editorTextFocus && ragAssistant.hasReview"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
