{
  "name": "autopilot",
  "displayName": "Autopilot",
  "description": "Autopilot - an AI coding assistant made from reverse engineered Jetski RAG architecture",
  "version": "1.2.3",
  "publisher": "hintstechnology",
  "author": "Hints Technology",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Machine Learning",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "ragAssistant.chatView",
          "name": "Autopilot",
          "icon": "media/autopilot.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "ragAssistant.addModel",
        "title": "Autopilot: Add Model"
      },
      {
        "command": "ragAssistant.setApiKey",
        "title": "Autopilot: Set API Key for Model"
      },
      {
        "command": "ragAssistant.newChat",
        "title": "Autopilot: New Chat"
      },
      {
        "command": "ragAssistant.openSettings",
        "title": "Autopilot: Open Settings"
      },
      {
        "command": "ragAssistant.indexWorkspace",
        "title": "Autopilot: Index Workspace (BM25)"
      },
      {
        "command": "ragAssistant.reloadMCP",
        "title": "Autopilot: Reload MCP Servers"
      },
      {
        "command": "ragAssistant.setGithubToken",
        "title": "Autopilot: Set GitHub Token (Research)"
      },
      {
        "command": "ragAssistant.setBrightDataKey",
        "title": "Autopilot: Set Bright Data API Key (Google search for Research)"
      },
      {
        "command": "ragAssistant.setOpenRouterKey",
        "title": "Autopilot: Set OpenRouter API Key"
      },
      {
        "command": "ragAssistant.review.acceptAll",
        "title": "Autopilot: Accept all changes in this file"
      },
      {
        "command": "ragAssistant.review.revertAll",
        "title": "Autopilot: Revert all changes in this file"
      }
    ],
    "configuration": {
      "title": "Autopilot",
      "properties": {
        "ragAssistant.models": {
          "type": "array",
          "default": [
            {
              "id": "ollama-cloud-gemma4",
              "name": "Gemma 4 31B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "gemma4:31b-cloud",
              "description": "Understands screenshots and images"
            },
            {
              "id": "ollama-cloud-gpt-oss",
              "name": "GPT-OSS 120B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "gpt-oss:120b-cloud",
              "description": "Strong reasoning for complex tasks",
              "family": "GPT-OSS",
              "variant": "120B"
            },
            {
              "id": "ollama-cloud-beam",
              "name": "Beam 550B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "beam",
