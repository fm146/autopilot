            },
            {
              "id": "ollama-cloud-nemotron-ultra",
              "name": "Nemotron 3 Ultra 550B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "nemotron-3-ultra:cloud",
              "description": "Most capable Nemotron for complex work",
              "family": "Nemotron 3",
              "variant": "Ultra 550B"
            },
            {
              "id": "ollama-cloud-nemotron-nano",
              "name": "Nemotron 3 Nano 30B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "nemotron-3-nano:30b-cloud",
              "description": "Light and fast for simpler tasks",
              "family": "Nemotron 3",
              "variant": "Nano 30B"
            },
            {
              "id": "ollama-cloud-gpt-oss-20b",
              "name": "GPT-OSS 20B",
              "provider": "ollama",
              "baseUrl": "https://ollama.com",
              "modelId": "gpt-oss:20b-cloud",
